{
    "name":"sourcefabric/newscoop",
    "description":"The open source CMS for news",
    "keywords":[
        "cms",
        "journalism",
        "publication"
    ],
    "homepage":"http://www.sourcefabric.org/en/newscoop/",
    "version": "4.4.6",
    "license":"GPL-3.0",
    "authors":[
        
    ],
    "repositories":[
        {
            "type":"artifact",
            "url":"plugins/private_plugins"
        }
    ],
    "require":{
        "php":"^8.3",
        "symfony/symfony":"^6.4",
        "doctrine/orm":"^2.17",
        "doctrine/common":"^2.13",
        "doctrine/doctrine-bundle":"^2.10",
        "twig/extensions":"^1.5",
        "symfony/assetic-bundle":"^2.8",
        "symfony/swiftmailer-bundle":"^3.5",
        "symfony/monolog-bundle":"^3.8",
        "sensio/distribution-bundle":"^5.0",
        "sensio/framework-extra-bundle":"^6.2",
        "sensio/generator-bundle":"^3.1",
        "incenteev/composer-parameter-handler":"^2.2",
        "bombayworks/zendframework1":"1.12.*",
        "friendsofsymfony/rest-bundle":"^3.5",
        "kriswallsmith/buzz":"^1.2",
        "knplabs/knp-paginator-bundle":"^5.9",
        "knplabs/knp-components":"^4.0",
        "jms/serializer-bundle":"^5.0",
        "jms/serializer":"^3.28",
        "hybridauth/hybridauth":"^3.11",
        "smarty/smarty":"^5.0",
        "knplabs/knp-menu-bundle":"^3.4",
        "knplabs/knp-menu":"^3.5",
        "friendsofsymfony/jsrouting-bundle":"^3.2",
        "willdurand/js-translation-bundle":"^5.0",
        "imagine/imagine":"^1.3",
        "symfony/twig-bridge":"^6.4",
        "newscoop/recaptcha-bundle":"^3.0",
        "friendsofsymfony/oauth-server-bundle":"^2.0",
        "newscoop/plugins-installer":"^1.0",
        "nelmio/api-doc-bundle":"^4.17",
        "hellogerard/jobby":"^2.1",
        "dflydev/doctrine-orm-service-provider":"^2.0",
        "pimple/pimple":"^3.5",
        "sentry/sentry":"^4.3",
        "stof/doctrine-extensions-bundle":"^1.11",
        "ext-pdo":"*",
        "ext-mbstring":"*",
        "ext-gd":"*",
        "ext-xml":"*",
        "ext-curl":"*",
        "ext-zip":"*",
        "ext-redis":"*"
    },
    "require-dev":{
        "phpunit/phpunit":"^10.5",
        "phpspec/phpspec":"^7.0",
        "liip/rmt":"^1.6",
        "behat/behat":"^3.13",
        "behat/common-contexts":"^1.5",
        "behat/mink":"^1.11",
        "behat/mink-extension":"^2.3",
        "behat/mink-goutte-driver":"^2.1",
        "behat/mink-selenium2-driver":"^1.6",
        "fzaninotto/faker":"^1.5",
        "raulfraile/ladybug-bundle":"^1.1"
    },
    "autoload":{
        "psr-0":{
            "Newscoop":[
                "src",
                "library"
            ],
            "Resource":"library",
            "Proxy":"library"
        },
        "classmap":[
            "classes",
            "template_engine",
            "plugins",
            "include",
            "application"
        ]
    },
    "include-path":[
        "include"
    ],
    "scripts":{
        "post-install-cmd":[
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap"
        ],
        "post-update-cmd":[
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap"
        ]
    },
    "minimum-stability":"stable",
    "config":{
        "bin-dir":"vendor/bin",
        "discard-changes":true,
        "process-timeout":3600,
        "allow-plugins": {
            "composer/installers": true,
            "newscoop/plugins-installer": true
        }
    },
    "extra":{
        "symfony-app-dir":"application",
        "symfony-web-dir":"public"
    },
    "branch-alias":{
        "dev-master":"4.4-dev"
    }
}
